# Copy this file to .env for local testing (Render/Railway/etc. use their own dashboard for these instead).
# NEVER commit a real .env file with a real key to a public git repository.

# Required: your real Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-real-key-here

# Optional: which Claude model to use. Defaults to claude-sonnet-5 if not set.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: comma-separated access codes you give to your students/class.
# If left blank, ANYONE who has your server URL can use it with no code — only leave this
# blank while testing privately.
ALLOWED_ACCESS_CODES=ECS2026

# Optional: maximum AI requests per access code (or per IP if no code) per day.
DAILY_LIMIT=40

# Optional: port to run on locally (hosting platforms usually set this for you automatically).
PORT=3000
